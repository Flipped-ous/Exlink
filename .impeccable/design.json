  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact source-based action with explicit hover and keyboard focus.",
      "html": "<button class=\"ds-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m8 5 11 7-11 7V5Z\"/></svg>Run demo</button>",
      "css": ".ds-primary{cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:9px;background:transparent;padding:6px 10px;min-height:30px;font-size:12px;white-space:nowrap;line-height:1.4;touch-action:manipulation;transition:background-color 160ms,color 160ms,box-shadow 160ms;font-family:'Segoe UI Variable Text','Segoe UI','Microsoft YaHei UI',sans-serif;color:var(--text, #efedf7);}.ds-primary:hover{;background-color:var(--primary-hover, #b19cf9)}.ds-primary:disabled{cursor:default;opacity:.43}.ds-primary:focus-visible{outline:2px solid var(--accent, #bdadff);outline-offset:3px}@media(prefers-reduced-motion:reduce){button,input{transition:none!important}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Compact source-based action with explicit hover and keyboard focus.",
      "html": "<button class=\"ds-secondary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m4 17 6-5-6-5M12 19h8\"/></svg>Connection</button>",
      "css": ".ds-secondary{cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:9px;background:transparent;padding:6px 10px;min-height:30px;font-size:12px;white-space:nowrap;line-height:1.4;touch-action:manipulation;transition:background-color 160ms,color 160ms,box-shadow 160ms;font-family:'Segoe UI Variable Text','Segoe UI','Microsoft YaHei UI',sans-serif;color:var(--text, #efedf7);background:linear-gradient(155deg,#ffffff0d,#ffffff02),var(--input, #282737);border-color:var(--border, #ffffff17);box-shadow:inset 0 1px 0 #ffffff0c}.ds-secondary:hover{;}.ds-secondary:disabled{cursor:default;opacity:.43}.ds-secondary:focus-visible{outline:2px solid var(--accent, #bdadff);outline-offset:3px}@media(prefers-reduced-motion:reduce){button,input{transition:none!important}}"
    },
    {
      "name": "Quiet action",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Compact source-based action with explicit hover and keyboard focus.",
      "html": "<button class=\"ds-quiet\">Clear logs</button>",
      "css": ".ds-quiet{cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:9px;background:transparent;padding:6px 10px;min-height:30px;font-size:12px;white-space:nowrap;line-height:1.4;touch-action:manipulation;transition:background-color 160ms,color 160ms,box-shadow 160ms;font-family:'Segoe UI Variable Text','Segoe UI','Microsoft YaHei UI',sans-serif;color:var(--text, #efedf7);color:var(--muted, #b0adc3)}.ds-quiet:hover{;}.ds-quiet:disabled{cursor:default;opacity:.43}.ds-quiet:focus-visible{outline:2px solid var(--accent, #bdadff);outline-offset:3px}@media(prefers-reduced-motion:reduce){button,input{transition:none!important}}"
    },
    {
      "name": "Icon action",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Compact source-based action with explicit hover and keyboard focus.",
      "html": "<button class=\"ds-icon-button\" aria-label=\"Close\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button>",
      "css": ".ds-icon-button{cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:9px;background:transparent;padding:6px 10px;min-height:30px;font-size:12px;white-space:nowrap;line-height:1.4;touch-action:manipulation;transition:background-color 160ms,color 160ms,box-shadow 160ms;font-family:'Segoe UI Variable Text','Segoe UI','Microsoft YaHei UI',sans-serif;color:var(--text, #efedf7);}.ds-icon-button:hover{;}.ds-icon-button:disabled{cursor:default;opacity:.43}.ds-icon-button:focus-visible{outline:2px solid var(--accent, #bdadff);outline-offset:3px}@media(prefers-reduced-motion:reduce){button,input{transition:none!important}}"
    },
    {
      "name": "Search input",
      "kind": "input",
      "refersTo": "input",
      "description": "Line-icon search with a focused containing border.",
      "html": "<label class=\"ds-search\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input class=\"ds-search-input\" aria-label=\"Search logs\" placeholder=\"Search logs\"/></label>",
      "css": ".ds-search{height:30px;display:flex;align-items:center;gap:6px;min-width:80px;flex:1;background:#0a091723;border:1px solid var(--border, #ffffff17);border-radius:7px;padding:0 8px;color:var(--muted, #b0adc3);font-family:'Segoe UI Variable Text','Segoe UI','Microsoft YaHei UI',sans-serif}.ds-search-input{background:var(--input, #282737);border:1px solid var(--border, #ffffff17);border-radius:8px;padding:7px 9px;font-size:12px;min-width:0;caret-color:var(--accent, #bdadff);;font-family:'Segoe UI Variable Text','Segoe UI','Microsoft YaHei UI',sans-serif;color:var(--text, #efedf7)}.ds-search-input::placeholder{color:var(--muted, #b0adc3);opacity:1}.ds-search:focus-within{border-color:var(--accent, #bdadff)}.ds-search-input:focus-visible{outline:2px solid var(--accent, #bdadff);outline-offset:3px}:host-context([data-theme=light]) .ds-search{background:#fff5}"
    },
    {
      "name": "Rail navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Active compact icon-and-text row, retaining the material state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Tools\"><button class=\"ds-nav-item\" aria-current=\"page\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m4 17 6-5-6-5M12 19h8\"/></svg>Serial</button></nav>",
      "css": ".ds-nav{width:96px}.ds-nav-item{cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:9px;background:transparent;padding:6px 10px;min-height:30px;font-size:12px;white-space:nowrap;line-height:1.4;touch-action:manipulation;transition:background-color 160ms,color 160ms,box-shadow 160ms;font-family:'Segoe UI Variable Text','Segoe UI','Microsoft YaHei UI',sans-serif;;}.ds-nav-item:hover{background:#ffffff09;color:var(--text, #efedf7)}.ds-nav-item svg{width:18px;height:18px;color:var(--accent, #bdadff)}.ds-nav-item:focus-visible{outline:2px solid var(--accent, #bdadff);outline-offset:3px}@media(prefers-reduced-motion:reduce){button,input{transition:none!important}}:host-context([data-theme=light]) .ds-nav-item{border-color:#fff9;box-shadow:inset 0 1px 0 #fff,0 5px 16px #78609616}"
    },
    {
      "name": "Demo badge",
      "kind": "chip",
      "refersTo": "demo-badge",
      "description": "Noninteractive source-state tag, not a general filter chip.",
      "html": "<span class=\"ds-demo\">Demo</span>",
      "css": ".ds-demo{display:inline-block;font-family:'Segoe UI Variable Text','Segoe UI','Microsoft YaHei UI',sans-serif;line-height:1.5;font-size:10px;color:var(--accent, #bdadff);background:#a794fa13;border:1px solid #a794fa28;padding:2px 7px;border-radius:5px}"
    },
    {
      "name": "Glass working panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Exact gradient material with reflected edges and a compact divided title.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-panel-header\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m4 17 6-5-6-5M12 19h8\"/></svg><h2 class=\"ds-panel-title\">Raw logs</h2></header><div class=\"ds-panel-content\">Receive and send in one session</div></section>",
      "css": ".ds-panel{background:var(--glass, linear-gradient(135deg,#ffffff0d,#ffffff03 50%,#ffffff00),#1b1c2bc9);border:1px solid var(--edge, #ffffff1d);box-shadow:inset 0 1px 0 var(--edge-bright, #ffffff32),inset 1px 0 0 #ffffff07,var(--shadow, 0 14px 38px #05040e34);backdrop-filter:blur(30px) saturate(135%);;min-width:250px;font:12px/1.5 'Segoe UI Variable Text','Segoe UI','Microsoft YaHei UI',sans-serif;color:var(--text, #efedf7)}.ds-panel-header{display:flex;align-items:center;justify-content:space-between;gap:10px;flex:0 0 51px;padding:0 15px;border-bottom:1px solid var(--border, #ffffff17);flex-basis:40px;padding-inline:13px;height:40px}.ds-panel-header svg{color:var(--accent, #bdadff)}.ds-panel-title{margin:0;font-size:13px;font-weight:600}.ds-panel-content{padding:13px;color:var(--muted, #b0adc3)}:host-context([data-glass=false]) .ds-panel{background:var(--surface, #1c1c29);backdrop-filter:none;box-shadow:none;border-color:var(--border, #ffffff17)}"
    },
    {
      "name": "Preference switch",
      "kind": "input",
      "refersTo": "switch",
      "description": "Native checkbox switch with the source thumb geometry and motion.",
      "html": "<input class=\"ds-switch\" type=\"checkbox\" role=\"switch\" aria-label=\"Follow logs\" checked/>",
      "css": ".ds-switch{appearance:none;position:relative;width:36px!important;height:21px!important;border-radius:14px;background:var(--input, #282737);border:1px solid var(--border, #ffffff17);padding:0;cursor:pointer;transition:background-color 150ms}.ds-switch:after{}.ds-switch:checked{background:var(--primary, #9c86f4)}.ds-switch:checked:after{}.ds-switch:focus-visible{outline:2px solid var(--accent, #bdadff);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-switch,.ds-switch:after{transition:none}}"
    },
    {
      "name": "Channel table row",
      "kind": "custom",
      "refersTo": "channel-row",
      "description": "Curve color, toggle and current/min/max values form one aligned row.",
      "html": "<label class=\"ds-channel\"><span class=\"ds-checkbox\"><input class=\"ds-channel-check\" type=\"checkbox\" checked aria-label=\"Show CH1\"/><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12 4 4L19 6\"/></svg></span><i class=\"ds-swatch\"></i><strong class=\"ds-channel-name\">CH1</strong><span class=\"ds-reading\">3.30 <small>V</small></span><span class=\"ds-stat\">3.26</span><span class=\"ds-stat\">3.34</span></label>",
      "css": ".ds-channel{--channel-color:var(--channel-0, #a798ff);display:flex;align-items:center;gap:9px;height:40px;cursor:pointer;border-bottom:1px solid #ffffff05;color:var(--text, #efedf7);height:33px;gap:6px;height:34px;grid-template-columns:13px 0 minmax(36px,1fr) 57px 47px 47px;gap:5px;height:27px;font:11px/1.5 'Segoe UI Variable Text','Segoe UI','Microsoft YaHei UI',sans-serif}.ds-channel:hover{background:#ffffff04}.ds-checkbox{width:13px;height:13px}.ds-channel-check{appearance:none;position:absolute;inset:0;width:15px;height:15px;border:1px solid currentColor;border-radius:4px;background:color-mix(in srgb,var(--channel-color) 14%,transparent);color:inherit;width:13px;height:13px;margin:0}.ds-checkbox svg{position:relative;pointer-events:none;width:12px;height:12px}.ds-channel-check:not(:checked)+svg{opacity:0}.ds-swatch{}.ds-channel-name{font:550 11px Consolas,monospace}.ds-reading{margin:0;justify-content:flex-end;font-size:11px;gap:3px;font-size:10px;font-family:Consolas,monospace;font-variant-numeric:tabular-nums}.ds-reading small{font-size:10px;color:var(--dim, #9a96b0);font-size:8px}.ds-stat{text-align:right;font:10px Consolas,monospace;color:var(--muted, #b0adc3);font-variant-numeric:tabular-nums;font-size:9px}.ds-channel-check:focus-visible{outline:2px solid var(--accent, #bdadff);outline-offset:3px}.ds-channel{display:grid;grid-template-columns:15px 12px minmax(45px,1fr) 66px 53px 53px;gap:7px;height:30px}.ds-swatch{display:block;visibility:visible;width:12px}.ds-reading{margin:0;justify-content:flex-end;font-size:11px;gap:3px}.ds-reading small{font-size:9px}.ds-stat{font-size:10px}"
    }
  ],
  "narrative": {
    "northStar": "The Compact Glass Bench",
    "overview": "EXLINK Studio is a mature, advanced desktop debugging assistant expressed as a compact glass bench. The approved purple folded-ribbon E anchors the identity; dark graphite, violet reflections and a companion pale-glass theme provide expressive Liquid Glass around readable operational data.\n\nDensity serves long bench sessions: thin task bars, restrained headings, aligned bytes and adjacent channel values keep the session in view. Glass is a material layer, while text, keyboard focus and signal colors remain explicit. The existing system UI stack is functional application typography rather than a decorative display face.",
    "keyCharacteristics": [
      "Expressive liquid glass with reflected edges and fluid ambient clouds.",
      "Compact operational density with aligned monospaced data.",
      "Purple folded-ribbon E identity in dark and light themes.",
      "Visible source, focus and signal state throughout the session."
    ],
    "rules": [
      {
        "name": "The Paired Ink Rule",
        "body": "Keep each theme's primary fill, hover fill and label ink together; primary action ink is a separate token from ordinary text.",
        "section": "colors"
      },
      {
        "name": "The Signal Identity Rule",
        "body": "Use the same channel color for its curve, checkbox and swatch; pair color with names and numeric values.",
        "section": "colors"
      },
      {
        "name": "The Data Alignment Rule",
        "body": "Use monospaced, tabular numeric data for bytes, timestamps and channel readings; keep interface labels in the UI stack.",
        "section": "typography"
      },
      {
        "name": "The Reflected Edge Rule",
        "body": "Glass combines a translucent surface, a thin bright edge and diffuse depth; preserve the solid-surface preference as an equally legible presentation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the approved folded purple E asset and its existing proportions.",
      "Do keep operational controls compact and the composer anchored beneath logs.",
      "Do use theme variables for text, focus, actions and channel colors.",
      "Do retain visible keyboard focus, explicit demo labeling and the reduced-motion preference.",
      "Do stack the compact plot above logs in narrow desktop windows."
    ],
    "donts": [
      "Don't replace the approved ribbon E with a generic symbol.",
      "Don't replace the operational workspace with dashboard metric-card framing.",
      "Don't mix primary action fill and ink tokens from different themes.",
      "Don't hide signal identity behind color alone or let glass obscure raw data.",
      "Don't promote one-off instrument reading sizes into the general heading scale."
    ]
  }
}
